# Local development: Vite proxies API requests to the backend.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8081

# Leave OIDC unset for local development without an identity provider.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email

# For a production build, set VITE_API_BASE_URL to the public API origin
# when the frontend host does not proxy /api, /evidence, and /health.
# VITE_API_BASE_URL=https://<your-api-origin>
# VITE_OIDC_AUTHORITY=https://<your-identity-provider>/
# VITE_OIDC_CLIENT_ID=<your-identity-provider-spa-client-id>
