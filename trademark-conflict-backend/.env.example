# Copy to .env for local development. Process environment values take precedence.
APP_ENV=development
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5189,http://127.0.0.1:5189
REDIS_URL=redis://localhost:6379/0
OCR_ENABLED=false
OCR_LANGUAGES=eng+mya
JOB_RETENTION_DAYS=90
CLEANUP_INTERVAL_SECONDS=86400
MAX_FILE_SIZE_MB=100
SIMILARITY_THRESHOLD=0.82
HIGH_SIMILARITY_THRESHOLD=0.90
ANALYSIS_TIMEOUT_SECONDS=3600

# MCP server settings (optional; these defaults match local API development).
BACKEND_BASE_URL=http://127.0.0.1:8081
EVIDENCE_PUBLIC_BASE_URL=http://127.0.0.1:8081/evidence
CORS_ORIGINS=http://localhost:5189,http://127.0.0.1:5189
MCP_ALLOW_LOCAL_PATHS=true

# For production, set APP_ENV=production and provide these real values:
# OIDC_ISSUER=https://<your-identity-provider>/
# OIDC_AUDIENCE=<your-api-audience>
# OIDC_JWKS_URL=https://<your-identity-provider>/.well-known/jwks.json
# OIDC_CLIENT_ID=<your-identity-provider-spa-client-id>
# EVIDENCE_URL_SIGNING_KEY=<generate-a-unique-cryptographically-random-secret>
# MCP_API_KEY=<generate-a-unique-secret-of-at-least-32-characters>
# OIDC_TENANT_CLAIM=tenant_id
# OIDC_ROLES_CLAIM=roles
# CORS_ALLOWED_ORIGINS=https://<your-frontend-origin>
# Set DATABASE_URL or DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASSWORD.
# Production also requires Redis and a running analysis worker.
